<%- include('partials/header', { titulo: (typeof titulo !== 'undefined' ? titulo : 'Productos') }) %>

<div class="container mb-5">
  <h1 class="mb-4">Nuestros Productos</h1>

  <div id="gridProductos" class="row g-4">
    <% (productos || []).forEach(p => { %>
      <%
        const stock = Number(p.StockActual) || 0;
        const min   = Number(p.StockMinimo) || 0;

        const badgeClass = (stock <= 0)
          ? 'bg-danger'
          : (stock <= min)
            ? 'bg-warning text-dark'
            : 'bg-success';

        const badgeText = (stock <= 0)
          ? 'Sin stock'
          : (stock <= min)
            ? ('⚠ Stock bajo: ' + stock)
            : ('Stock: ' + stock);
      %>

      <div class="col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm">

          <!-- Imagen o placeholder -->
          <div style="width:100%; height:180px; background:#f2f2f2; display:flex; align-items:center; justify-content:center;">
            <% if (p.Imagen) { %>
              <img src="<%= p.Imagen %>" alt="Imagen de <%= p.Nombre %>" style="width:100%; height:100%; object-fit:cover;">
            <% } else { %>
              <span class="text-muted">Producto</span>
            <% } %>
          </div>

          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= p.Nombre %></h5>
            <p class="card-text small text-muted mb-2"><%= p.Descripcion || '...' %></p>

            <div class="mt-auto">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold">₡ <%= Number(p.Precio).toLocaleString() %></span>

                <span class="badge <%= badgeClass %>">
                  <%= badgeText %>
                </span>
              </div>

              <a 
                href="/ventas/nueva?producto=<%= encodeURIComponent(p.ProductoID) %>"
                class="btn btn-primary w-100 <%= stock <= 0 ? 'disabled' : '' %>"
                aria-disabled="<%= stock <= 0 ? 'true' : 'false' %>">
                Vender
              </a>
            </div>
          </div>

        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
// --- Refresco automático cada 10s ---
async function cargarProductos() {
  try {
    const res = await fetch('/productos/api', { cache: 'no-store' });
    const data = await res.json();
    renderGrid(data);
  } catch (e) {
    console.error('Error cargando productos:', e);
  }
}

function renderGrid(items) {
  const grid = document.getElementById('gridProductos');

  grid.innerHTML = (items || []).map(p => {
    const stock = Number(p.StockActual) || 0;
    const min   = Number(p.StockMinimo) || 0;

    let badge = '';
    if (stock <= 0) {
      badge = `<span class="badge bg-danger">Sin stock</span>`;
    } else if (stock <= min) {
      badge = `<span class="badge bg-warning text-dark">⚠ Stock bajo: ${stock}</span>`;
    } else {
      badge = `<span class="badge bg-success">Stock: ${stock}</span>`;
    }

    const imgHtml = p.Imagen
      ? `<img src="${encodeURI(p.Imagen)}" alt="Imagen de ${escapeHtml(p.Nombre)}" style="width:100%; height:100%; object-fit:cover;">`
      : `<span class="text-muted">Producto</span>`;

    const href = `/ventas/nueva?producto=${encodeURIComponent(p.ProductoID)}`;
    const disabled = stock <= 0;

    return `
      <div class="col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm">
          <div style="width:100%; height:180px; background:#f2f2f2; display:flex; align-items:center; justify-content:center;">
            ${imgHtml}
          </div>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">${escapeHtml(p.Nombre)}</h5>
            <p class="card-text small text-muted mb-2">${escapeHtml(p.Descripcion || '...')}</p>

            <div class="mt-auto">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold">₡ ${Number(p.Precio).toLocaleString()}</span>
                ${badge}
              </div>

              <a href="${href}" class="btn btn-primary w-100 ${disabled ? 'disabled' : ''}"
                 aria-disabled="${disabled ? 'true' : 'false'}">Vender</a>
            </div>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

// Evita inyección
function escapeHtml(str='') {
  return String(str)
    .replaceAll('&','&amp;').replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;')
    .replaceAll("'",'&#39;');
}

cargarProductos();
setInterval(cargarProductos, 10000);
</script>

<%- include('partials/footer') %>
